# .htaccess : dentiste-paris12.com
# HTTPS + www forcés, URLs propres (sans .html), redirections depuis l'ancien site WordPress

RewriteEngine On

# --- Force HTTPS et www en un seul saut (évite les redirections en chaîne et l'exposition du port) ---
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.dentiste-paris12.com/$1 [R=301,L]

# --- En-tête HSTS : indique aux navigateurs de toujours utiliser HTTPS pour ce domaine ---
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# --- Anciennes fiches PDF (WordPress) -> fiches HTML correspondantes ---
RewriteRule ^wp-content/uploads/fiche-brossage\.pdf$ https://www.dentiste-paris12.com/le-brossage [R=301,L,NC]
RewriteRule ^wp-content/uploads/Fiche-Carie\.pdf$ https://www.dentiste-paris12.com/la-carie-dentaire [R=301,L,NC]
RewriteRule ^wp-content/uploads/fiche-parodontale\.pdf$ https://www.dentiste-paris12.com/la-maladie-parodontale [R=301,L,NC]
RewriteRule ^wp-content/uploads/Fiche-Apthe\.pdf$ https://www.dentiste-paris12.com/aphte-dentiste-paris12 [R=301,L,NC]
RewriteRule ^wp-content/uploads/fluor-afssaps\.pdf$ https://www.dentiste-paris12.com/le-fluor [R=301,L,NC]

# --- Ancienne page « Le cabinet », supprimée : redirection vers l’équipe ---
RewriteRule ^cabinet-implant-dentaire-paris-daumesnil/?$ https://www.dentiste-paris12.com/cabinet-chirurgien-dentiste-paris [R=301,L]

# --- Retire un slash final superflu (héritage des anciennes URLs WordPress) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://www.dentiste-paris12.com/$1 [R=301,L]

# --- index ou index.html -> racine ---
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ https://www.dentiste-paris12.com/ [R=301,L]

# --- Requête directe vers un .html -> redirige vers l'URL sans extension ---
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ https://www.dentiste-paris12.com/%1 [R=301,L]

# --- Sert en interne le fichier .html correspondant, sans changer l'URL affichée ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
