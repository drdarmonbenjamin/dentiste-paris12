# Dossier interne du blog (generateur, sources, dossier de relecture) : acces refuse a tout visiteur.
# Les fichiers se consultent en local, dans le dossier decompresse du site.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
